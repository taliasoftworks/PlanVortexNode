# =============================================================================
#  CAPA 3 — tests contra un PlanVortex de VERDAD.
#
#  Cópialo a `.env.live` (que está gitignorado) y rellena lo de abajo. Después:
#
#      npm run test:live
#
#  Sin este fichero, `npm run test:live` no falla: se salta entero diciendo qué falta.
#  Y `npm test` (capas 1 y 2) nunca lo mira.
# =============================================================================

# Contra qué servidor. CON el prefijo de versión y sin barra final.
# Lo normal es tu stack local (`docker compose up -d` en PlanVortexServer).
PLANVORTEX_LIVE_BASE_URL=http://localhost:3000/v1.0.0

# Credenciales de una app de cliente (panel: Ajustes > Apps). Llevan prefijo LIVE_ a
# propósito: un `.env` con las credenciales de producción NO debe armar esta suite.
PLANVORTEX_LIVE_CLIENT_ID=
PLANVORTEX_LIVE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
#  Qué organización y qué cuenta. Opcionales: sin esto se coge la primera.
# -----------------------------------------------------------------------------

# LIVE_ORGANIZATION_ID=
# LIVE_ACCOUNT_ID=

# La imagen que se sube en las pruebas de escritura. Por defecto, el logo del repo.
# LIVE_IMAGE_PATH=./assets/logo-horizontal.png

# Un vídeo, para las redes que no publican imágenes. No hay uno por defecto —un MP4 no se
# mete en el repo de una librería—, así que sin esto la prueba de publicación se salta
# cuando la única cuenta conectada es de YouTube o TikTok. Vale cualquier MP4 corto:
#
#     ffmpeg -f lavfi -i color=c=black:s=640x360:d=3 -f lavfi -i anullsrc -shortest \
#            -c:v libx264 -pix_fmt yuv420p -c:a aac live.mp4
#
# LIVE_VIDEO_PATH=./live.mp4


# -----------------------------------------------------------------------------
#  Interruptores de escritura. Todos apagados por defecto.
# -----------------------------------------------------------------------------

# Permite SUBIR ficheros y CREAR publicaciones. Lo que se crea se programa a un día vista
# y se borra al terminar el test, así que no sale a ninguna red social.
LIVE_ALLOW_PUBLISH=0

# Permite PUBLICAR YA, de verdad, en la red conectada. Interruptor aparte del anterior por
# la misma razón por la que el servidor separa los comentarios: programar es privado y
# reversible; publicar es público, inmediato y le llega a gente.
# LIVE_ALLOW_SOCIAL_PUBLISH=1

# Escribir contra api.planvortex.com exige decirlo dos veces. Sin esto, la suite revienta
# nada más arrancar en vez de tocar una organización real.
# LIVE_ALLOW_PRODUCTION=1

# Otro fichero de entorno, si prefieres tener varios (uno por stack, por ejemplo).
# LIVE_ENV_FILE=.env.live.produccion
